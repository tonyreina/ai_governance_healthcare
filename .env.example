# =============================================================================
# Copy to .env and edit:   cp .env.example .env
#
# .env is read automatically by `docker compose`. It is git-ignored. Nothing in
# this file is a real secret -- every value here is either a safe default or an
# obvious placeholder you are expected to replace.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_DB=chai
POSTGRES_USER=chai

# REQUIRED. compose.yaml has no default for this: an unset value stops the
# stack rather than booting a database with a password from a sample file.
# Generate one with:  openssl rand -base64 32
POSTGRES_PASSWORD=replace-me-before-first-run

# In a cloud deployment you will usually drop the `db` service entirely and
# point the API at a managed instance (Cloud SQL, RDS, Azure Database for
# PostgreSQL). Then set DATABASE_URL instead of the three values above, and
# prefer the platform's identity-based connection over a password:
#   DATABASE_URL=postgresql://chai@/chai?host=/cloudsql/PROJECT:REGION:INSTANCE

# -----------------------------------------------------------------------------
# Where the proxy listens
# -----------------------------------------------------------------------------
HTTP_PORT=8080
# Bind address for the published port. 0.0.0.0 to serve the network;
# 127.0.0.1 when something else on the host terminates TLS in front.
HTTP_BIND=0.0.0.0

# Caddy's site address.
#   http://:80          plain HTTP -- correct behind a cloud SSO front door
#                       (IAP, ALB, Front Door / Easy Auth) that terminates TLS
#   governance.example.org
#                       Caddy is the public edge and gets its own certificate
#                       automatically; publish 80 and 443 in that case
SITE_ADDRESS=http://:80

# -----------------------------------------------------------------------------
# IDENTITY -- the one setting that decides who the application thinks you are.
#
# The proxy deletes any identity header the browser sent, then sets
# X-Auth-Request-User / -Name / -Email from the three values below. Each is
# either a literal string or a Caddy placeholder naming a header the SSO front
# door set. Pick ONE block.
#
# Required: IDENTITY_ID_SOURCE has no default in compose.yaml, because a stack
# that silently falls back to an anonymous user is worse than one that refuses
# to start.
# -----------------------------------------------------------------------------

# --- Local development, no SSO ------------------------------------------------
IDENTITY_ID_SOURCE=dev@localhost
IDENTITY_NAME_SOURCE=Dev User
IDENTITY_EMAIL_SOURCE=dev@localhost

# --- Google Cloud: Identity-Aware Proxy ---------------------------------------
# IAP sets these on every request it forwards and overwrites any client copy.
# The email arrives prefixed "accounts.google.com:"; strip it in the API.
# IDENTITY_ID_SOURCE={http.request.header.X-Goog-Authenticated-User-Id}
# IDENTITY_NAME_SOURCE={http.request.header.X-Goog-Authenticated-User-Email}
# IDENTITY_EMAIL_SOURCE={http.request.header.X-Goog-Authenticated-User-Email}

# --- AWS: Application Load Balancer with an authenticate-oidc action ----------
# x-amzn-oidc-identity is the IdP's "sub" claim. x-amzn-oidc-data is a signed
# JWT with the full claim set; verify it in the API if you want the name and
# email cryptographically, rather than trusting the plain header.
# IDENTITY_ID_SOURCE={http.request.header.X-Amzn-Oidc-Identity}
# IDENTITY_NAME_SOURCE={http.request.header.X-Amzn-Oidc-Identity}
# IDENTITY_EMAIL_SOURCE={http.request.header.X-Amzn-Oidc-Identity}

# --- Azure: App Service / Container Apps "Easy Auth" with Microsoft Entra ID --
# X-Ms-Client-Principal is base64 JSON with every claim; the two scalar headers
# are the convenient subset.
# IDENTITY_ID_SOURCE={http.request.header.X-Ms-Client-Principal-Id}
# IDENTITY_NAME_SOURCE={http.request.header.X-Ms-Client-Principal-Name}
# IDENTITY_EMAIL_SOURCE={http.request.header.X-Ms-Client-Principal-Name}

# --- Self-hosted oauth2-proxy / Keycloak gatekeeper ---------------------------
# IDENTITY_ID_SOURCE={http.request.header.X-Forwarded-User}
# IDENTITY_NAME_SOURCE={http.request.header.X-Forwarded-Preferred-Username}
# IDENTITY_EMAIL_SOURCE={http.request.header.X-Forwarded-Email}

# -----------------------------------------------------------------------------
# What the API reads. These must match the header names written in
# proxy/Caddyfile -- change one, change both.
# -----------------------------------------------------------------------------
AUTH_HEADER_ID=X-Auth-Request-User
AUTH_HEADER_NAME=X-Auth-Request-Name
AUTH_HEADER_EMAIL=X-Auth-Request-Email

# Refuse any request with no identity instead of inventing an anonymous user.
# Leave this true. Sign-offs recorded against "anonymous" are worthless for audit.
REQUIRE_IDENTITY=true

# Second line of defense: the API rejects a connection whose peer address is
# outside this range, so a networking mistake cannot quietly turn the identity
# header into a free-for-all. 172.16.0.0/12 is Docker's default bridge pool.
# Narrow it to the proxy's address, or to the load balancer's subnet, if you can.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# -----------------------------------------------------------------------------
# API image
# -----------------------------------------------------------------------------
# Unset: compose builds ./api locally and tags it chai-governance-api:local.
# In a cloud, point this at a registry tag pinned by digest:
#   API_IMAGE=europe-west4-docker.pkg.dev/PROJECT/chai/api@sha256:abc123...
# API_IMAGE=chai-governance-api:local

LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Development-only (read by compose.dev.yaml, ignored by compose.yaml)
# -----------------------------------------------------------------------------
DEV_DB_PORT=5432
DEV_API_PORT=8000
DEV_IDENTITY_ID=dev@localhost
DEV_IDENTITY_NAME=Dev User
DEV_IDENTITY_EMAIL=dev@localhost
